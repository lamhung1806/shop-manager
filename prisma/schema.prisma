generator client {
  provider      = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  role        ROLE     @default(SELLER)
  createdAt   DateTime @default(now()) @map("created_at")
  phoneNumber String?  @unique @map("phone_number")
  updatedAt   DateTime @updatedAt @map("updated_at")
  refreshToken String? @map("refresh_token")
  UserShops   UserShops[]

  @@map("user")
}

model UserShops {
  tiktokShopId String
  appUserId    String
  isDeleted    Boolean
  createdOn    DateTime    @db.Timestamp(6)
  updatedOn    DateTime    @db.Timestamp(6)
  User  User @relation(fields: [appUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserShops_AspNetUsers_AppUserId")
  TiktokShops  TiktokShops @relation(fields: [tiktokShopId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_UserShops_TiktokShops_TiktokShopId")

  @@id([tiktokShopId, appUserId], map: "PK_UserShops")
  @@index([appUserId], map: "IX_UserShops_AppUserId")
  @@map("user_shops")
}


model TiktokShops {
  id            String        @id()
  cipher        String?
  name          String?
  nameSuggest   String?
  code          String?
  region        String?
  openId        String        @unique
  appKey        String?
  appSecret     String?
  isDeleted     Boolean?      @default(false)
  createdOn     DateTime      @db.Timestamp(6)
  updatedOn     DateTime      @db.Timestamp(6)
  clientId      String?
  status        String?
  Orders        Orders[]
  tiktokToken TiktokToken @relation(fields: [openId], references: [openId], onDelete: Cascade, onUpdate: NoAction)
  UserShops     UserShops[]

  @@map("tiktok_shops")

}

model TiktokToken {
  openId               String        @id()
  accessToken          String
  accessTokenExpireIn  BigInt
  refreshToken         String
  refreshTokenExpireIn BigInt
  sellerName           String
  sellerBaseRegion     String
  userType             Int
  isDeleted            Boolean?      @default(false)
  createdOn            DateTime      @db.Timestamp(6)
  updatedOn            DateTime      @db.Timestamp(6)
  TiktokShops          TiktokShops?
  @@map("tiktok_tokens")
}


model OrderDetail {
  orderId   String @unique()
  productId String
  quantity  Int
  isDeleted Boolean
  createdOn DateTime @db.Timestamp(6)
  updatedOn DateTime @db.Timestamp(6)
  Orders    Orders   @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction, map: "FK_OrderDetails_Orders_OrderId")
  // Products  Products @relation(fields: [ProductId], references: [ProductId], onDelete: Cascade, onUpdate: NoAction, map: "FK_OrderDetails_Products_ProductId")

  @@id([orderId, productId], map: "PK_OrderDetails")
  @@index([productId], map: "IX_OrderDetails_ProductId")
}

model Orders {
  orderId                   String         @id(map: "PK_Orders")
  shopId                    String?
  productQuantity           Int?
  totalAmount               Decimal?       @db.Decimal
  status                    String?
  note                      String?
  baseCost                  Decimal?       @db.Decimal
  baseCostDesign            Decimal?       @db.Decimal
  label                     String?
  fulfillName               String?
  createTimeFromTiktok      DateTime?      @db.Timestamp(6)
  originalTotalProductPrice String?
  sellerDiscount            String?
  shippingFee               String?
  productTax                String?
  shippingFeeTax            String?
  shippingFeeSellerDiscount String?
  shippingType              String?
  isDeleted                 Boolean
  createdOn                 DateTime       @db.Timestamp(6)
  updatedOn                 DateTime       @db.Timestamp(6)
  OrderDetail              OrderDetail?
  TiktokShops               TiktokShops?   @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_Orders_TiktokShops_ShopId")
  @@index([shopId], map: "IX_Orders_ShopId")
  @@map("orders")
}




